PORT=5001
MONGODB_URI=mongodb://localhost:27017/libota
# A long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
NODE_ENV=development

# Online only: the address(es) of the website allowed to call this API, comma separated.
# Leave empty while developing (everything is allowed).
CORS_ORIGIN=

# Photos. Leave empty to keep photos on disk (the uploads folder).
# To store them on Cloudinary, paste the "API environment variable" from your Cloudinary dashboard:
#   cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=